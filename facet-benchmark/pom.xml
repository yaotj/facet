<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <!--
      4.1.0 model 本可让 <parent/> 留空、由 Maven 4 按目录推断坐标，但发布到 Central 的
      是这份源 pom，而 Central 的标准解析器读到空的 parent 坐标会直接判 Invalid POM。
      （Maven 4 自己装进 ~/.m2 的是推断后的完整 pom，但 central-staging 打包的是源文件。）
      所以显式写全坐标：本地构建与发布两侧都拿到可解析的 pom。
    -->
    <parent>
        <groupId>io.github.yaotj</groupId>
        <artifactId>facet-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>facet-benchmark</artifactId>
    <name>Facet Benchmark</name>
    <description>JMH 基准：check 与 lookupResources 关键路径的可复跑测量。非模块化，靠 classpath 消费内核。</description>

    <properties>
        <!--
          基准不是给下游用的库，必须整包排除在发布之外。

          skipPublishing 是 central-publishing-maven-plugin 自己的开关（0.9.0 起按模块独立生效）。
          只设 maven.deploy.skip 挡不住它——那仅对 maven-deploy-plugin 有效，central 插件照收不误，
          结果 benchmark 带着"只有 jar、没有 sources 与 javadoc"的形态混进 bundle，
          整批 validation 被判失败（Central 要求每个 jar 都配 sources + javadoc）。
        -->
        <skipPublishing>true</skipPublishing>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-dsl-rebac</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-store-memory</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven 4 不再从编译 classpath 自动发现注解处理器，必须显式声明 JMH 的代码生成器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>1.37</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- 一键跑基准：mvn -pl facet-benchmark exec:exec -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>facet.benchmark.BenchmarkMain</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
