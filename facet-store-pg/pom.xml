<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <!--
      4.1.0 model 本可让 <parent/> 留空、由 Maven 4 按目录推断坐标，但发布到 Central 的
      是这份源 pom，而 Central 的标准解析器读到空的 parent 坐标会直接判 Invalid POM。
      （Maven 4 自己装进 ~/.m2 的是推断后的完整 pom，但 central-staging 打包的是源文件。）
      所以显式写全坐标：本地构建与发布两侧都拿到可解析的 pom。
    -->
    <parent>
        <groupId>io.github.yaotj</groupId>
        <artifactId>facet-parent</artifactId>
        <version>4.0.0</version>
    </parent>

    <artifactId>facet-store-pg</artifactId>
    <name>Facet Store :: PostgreSQL</name>
    <description>把 Plan 下推成一条 SQL（递归层级走 WITH RECURSIVE），并用时效表兑现一致性坐标。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-core</artifactId>
        </dependency>

        <!--
          编译期只要 java.sql：JDBC 驱动是运行期实现，不该把使用方钉在某个驱动版本上。
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 跨适配器一致性断言：同一份判定矩阵在内存实现与 PG 实现上必须一致 -->
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-store-memory</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 没有 SLF4J 绑定时 testcontainers 的诊断信息会被整段吞掉，排查容器问题无从下手 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              docker-java 默认协商 Docker API 1.32，而 Docker 25+ / OrbStack 已拒绝低于 1.40
              的客户端。它读的是系统属性 api.version（不是 testcontainers.properties），
              所以只能在这里设。不设的话报错是 "Could not find a valid Docker environment"，
              完全看不出真实原因。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>1.43</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
