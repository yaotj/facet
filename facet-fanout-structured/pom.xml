<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <!--
      4.1.0 model 本可让 <parent/> 留空、由 Maven 4 按目录推断坐标，但发布到 Central 的
      是这份源 pom，而 Central 的标准解析器读到空的 parent 坐标会直接判 Invalid POM。
      （Maven 4 自己装进 ~/.m2 的是推断后的完整 pom，但 central-staging 打包的是源文件。）
      所以显式写全坐标：本地构建与发布两侧都拿到可解析的 pom。
    -->
    <parent>
        <groupId>io.github.yaotj</groupId>
        <artifactId>facet-parent</artifactId>
        <version>4.2.0</version>
    </parent>

    <artifactId>facet-fanout-structured</artifactId>
    <name>Facet Fanout :: Structured Concurrency</name>
    <description>用结构化并发实现扇出。整个工程唯一带 --enable-preview 的模块。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 并行与顺序实现的差分测试需要一个真实存储和一批随机场景 -->
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-store-memory</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-testkit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              StructuredTaskScope 在 JDK 25 仍是 preview（第五轮），且它的 API 已经改过几次。
              把 preview 关进这一个模块，内核就能一直停在 release 级 API 上；
              下次 API 再变，只有这里要改。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-preview</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
