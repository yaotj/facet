<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <!--
      4.1.0 model 本可让 <parent/> 留空、由 Maven 4 按目录推断坐标，但发布到 Central 的
      是这份源 pom，而 Central 的标准解析器读到空的 parent 坐标会直接判 Invalid POM。
      （Maven 4 自己装进 ~/.m2 的是推断后的完整 pom，但 central-staging 打包的是源文件。）
      所以显式写全坐标：本地构建与发布两侧都拿到可解析的 pom。
    -->
    <parent>
        <groupId>io.github.yaotj</groupId>
        <artifactId>facet-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>facet-dsl-abac</artifactId>
    <name>Facet DSL :: ABAC</name>
    <description>属性式前端。策略编译成 Guarded，属性等级在此确定。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-core</artifactId>
        </dependency>

        <!-- 前端的验收标准是"产物能被内核直接求值"，所以测试要跑在一个真实适配器上 -->
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-store-memory</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
