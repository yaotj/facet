<?xml version="1.0" encoding="UTF-8"?>
<!--
  本工程用 Maven 4 的 POM 4.1.0 模型（<subprojects> 自动发现子项目、<parent/> 留空由
  Maven 4 按目录推断坐标）。这是构建期模型，保留它不损失任何能力。

  发布到 Central 的坑在这里：central-publishing-maven-plugin 目前仍按 Maven 3 语义把
  工程的 build POM（这里是 4.1.0 命名空间）当作 <artifactId>.pom 上传，而 Central 的标准
  解析器只认 POM/4.0.0，于是整批 deployment 判 "Failed to get coordinates"。

  解法不是改构建模型，而是让上传的 pom 本身是合规的 4.0.0 consumer POM：
  - .mvn/maven-user.properties 里 maven.consumer.pom.flatten=true，让 Maven 4 产出
    自包含、内联了 parent / url / licenses / scm / developers 的 consumer POM；
  - 中央插件配置里用 forcedStagingDirectory 指向一份手工 assemble 的 staging 目录，
    其中 <artifactId>.pom 用的是 consumer POM（重命名为 xxx.pom），而不是 4.1.0 源 pom。
  这样既保留 4.1.0 构建模型，又能让 Central 收到可解析的制品。
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <groupId>io.github.yaotj</groupId>
    <artifactId>facet-parent</artifactId>
    <version>3.0.0</version>
    <packaging>pom</packaging>

    <name>Facet</name>
    <description>统一权限内核：ACL / RBAC / ABAC / ReBAC 编译到同一份 IR</description>
    <url>https://github.com/yaotj/facet</url>

    <!--
      Central 要求 developers 与 scm 必填，缺了整批 deployment 会被 validation 拒收。
      两者都是"发布许可证"，不是可选的社交链接——Central 用它们把制品接回它的源码与责任人。
    -->
    <developers>
        <developer>
            <id>yaotj</id>
            <name>yaotj</name>
            <url>https://github.com/yaotj</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/yaotj/facet.git</connection>
        <developerConnection>scm:git:ssh://github.com:yaotj/facet.git</developerConnection>
        <url>https://github.com/yaotj/facet</url>
    </scm>

    <!--
      声明在父 pom 里，所有子模块继承——发布出去的每个 pom 都带上许可证信息。
      没有这段声明，分发出去的 jar 在法律上默认是"保留所有权利"，下游无权再分发。
    -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          mvnup -a 把这个属性换成了 <build><sources><source><targetVersion>25，
          结果编译目标静默退回 1.8（父 pom 的 <sources> 不向子模块继承，
          且 3.x 的 compiler plugin 不读 targetVersion）。改回属性。
          等换用 maven-compiler-plugin 4.x 时再重新评估 <sources>。
        -->
        <maven.compiler.release>25</maven.compiler.release>

        <!--
          3.14.0 在 Maven 4 下会抛 "Unsupported class file major version 69"：
          它内置的 ASM 读不懂 Java 25 的 class 文件，而 Maven 4 走的模块描述符解析路径
          会触发这段代码（Maven 3.9 不触发，所以同一份 pom 在 3.9.10 下能过）。
        -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <junit.version>5.13.4</junit.version>
        <postgresql.version>42.7.4</postgresql.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <jackson.version>2.18.2</jackson.version>

        <!--
          Central 要求每个 jar 配 sources + javadoc，且所有产物都要 GPG 签名（.asc）。
          版本集中在这里，避免散落在 <plugin> 里。
        -->
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      4.1.0 model 能按目录自动发现子项目，但这里保留显式清单：它是唯一记录
      模块角色划分的地方，也能挡住误把无关目录卷进 reactor。
    -->
    <subprojects>
        <!-- 内核：IR + 求值器 + 端口。依赖仅 java.base -->
        <subproject>facet-core</subproject>

        <!-- 编译前端：各模型的书写方式 -> Perm IR。单向依赖 core -->
        <subproject>facet-dsl-rebac</subproject>
        <subproject>facet-dsl-rbac</subproject>
        <subproject>facet-dsl-abac</subproject>

        <!-- IR 的编解码。独立模块，内核因此不必为序列化带上 JSON 依赖 -->
        <subproject>facet-ir-json</subproject>

        <!-- driven 适配器 -->        <subproject>facet-store-memory</subproject>
        <subproject>facet-store-pg</subproject>
        <subproject>facet-fanout-structured</subproject>

        <!-- driving 适配器 -->
        <subproject>facet-pdp-http</subproject>

        <!-- 驱动侧第二种形态：进程内判定门面（不依赖 HTTP） -->
        <subproject>facet-sdk</subproject>

        <!-- 判定矩阵 golden file 的测试基建 -->
        <subproject>facet-testkit</subproject>

        <!-- JMH 基准：check / lookupResources 的可复跑测量 -->
        <subproject>facet-benchmark</subproject>
    </subprojects>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              发布相关的插件全部挂在父 pom 上、由子模块继承，而不是逐个模块重复声明。
              facet-benchmark 排除在外：JMH 基准不是给下游用的库，发出去只会污染检索结果。
            -->

            <!-- Central 硬性要求：每个 jar 都要有 -sources.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Central 硬性要求：每个 jar 都要有 -javadoc.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!--
                      本项目的文档全是中文 javadoc，-doclint:none 是为了让 doclint 别拿
                      HTML/自闭合标签这类无意义的规则挑错；缺文档引用之类真正的错误仍应暴露。
                    -->
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <encoding>UTF-8</encoding>
                    <charset>UTF-8</charset>
                    <docencoding>UTF-8</docencoding>

                    <!--
                      release 与 preview 开关必须显式给出：

                      javadoc 不继承编译器的 maven.compiler.release / compilerArgs，它按
                      "当前 JDK + 默认 preview 开关"解析源码。于是 StructuredTaskScope
                      （facet-fanout-structured）在编译期是正式 API、在 javadoc 期却被判为
                      预览 API 而失败——两者对同一个 API 的判断不一致。

                      注意 preview 开关只能走 additionalOptions：maven-javadoc-plugin 3.11.2
                      没有 enablePreview 参数（用 -X 看到的同名配置项属于 compiler 插件的 Mojo，
                      写在这里不生效）。release 参数则必须与 preview 开关同时存在，
                      两者一起才与编译期保持一致。
                    -->
                    <release>${maven.compiler.release}</release>
                    <additionalOptions>
                        <additionalOption>--enable-preview</additionalOption>
                    </additionalOptions>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!--
          签名与上传只在这个 profile 里生效。

          理由很实际：gpg-plugin 绑在 verify 阶段，留在默认构建里会让每一次本地
          mvn install 都要求 GPG 私钥——没有密钥的开发者（和 CI 的普通构建）直接失败。
          发布是少数动作，不该由它来约束所有人的日常构建。
        -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <!-- Central 硬性要求：所有产物 GPG/PGP 签名 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>central-publish</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>publish</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                              Maven 4 的 source pom 用的是 POM/4.1.0 命名空间，Central 的标准
                              解析器读不了这种格式，于是整份被判 "Failed to get coordinates"，
                              并连带报出 url / licenses / scm / developers 全部缺失
                              —— 哪怕这些信息在父 pom 里其实都有。
                              （实测一次 deployment 330 条错误，全部源于此。）

                              真正能被 Central 正确解析的是 flatten 后的 consumer pom：
                              它是 POM/4.0.0 命名空间、parent 已内联、依赖带版本。
                              所以这里把 4.1.0 的 source pom 挡在 bundle 外，只上传 consumer pom。
                            -->
                            <excludeArtifacts>
                                <excludeArtifact>*:*-build.pom</excludeArtifact>
                                <excludeArtifact>*:*-build.pom.asc</excludeArtifact>
                            </excludeArtifacts>
                            <!--
                              自动发布：validation 通过即同步到 Central。
                              首次发布建议先用 false，确认 validation 结果无误后再改 true——
                              Central 发布后不可撤回，这一步的差别很实质。
                            -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>

                    <!--
                      Maven 4 下不能用 extensions=true：它替换掉 deploy 阶段的默认绑定，
                      却没把自己的 publish goal 注册进去，结果 deploy 阶段静默消失——
                      BUILD SUCCESS 但什么都没上传。（-X 里能看到 lifecycle 含 deploy，
                      实际既没有 maven-deploy-plugin 也没有 central 的 publish。）
                      代价是 default-deploy 会回来，而它没有 distributionManagement 就先失败，
                      所以必须显式 skip 掉它。
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.3</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
