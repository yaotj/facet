<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <groupId>io.github.yaotj</groupId>
    <artifactId>facet-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Facet</name>
    <description>统一权限内核：ACL / RBAC / ABAC / ReBAC 编译到同一份 IR</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          mvnup -a 把这个属性换成了 <build><sources><source><targetVersion>25，
          结果编译目标静默退回 1.8（父 pom 的 <sources> 不向子模块继承，
          且 3.x 的 compiler plugin 不读 targetVersion）。改回属性。
          等换用 maven-compiler-plugin 4.x 时再重新评估 <sources>。
        -->
        <maven.compiler.release>25</maven.compiler.release>

        <!--
          3.14.0 在 Maven 4 下会抛 "Unsupported class file major version 69"：
          它内置的 ASM 读不懂 Java 25 的 class 文件，而 Maven 4 走的模块描述符解析路径
          会触发这段代码（Maven 3.9 不触发，所以同一份 pom 在 3.9.10 下能过）。
        -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    </properties>

    <!--
      4.1.0 model 能按目录自动发现子项目，但这里保留显式清单：它是唯一记录
      模块角色划分的地方，也能挡住误把无关目录卷进 reactor。
    -->
    <subprojects>
        <!-- 内核：IR + 求值器 + 端口。依赖仅 java.base -->
        <subproject>facet-core</subproject>

        <!-- 编译前端：各模型的书写方式 -> Perm IR。单向依赖 core -->
        <subproject>facet-dsl-rebac</subproject>
        <subproject>facet-dsl-rbac</subproject>
        <subproject>facet-dsl-abac</subproject>

        <!-- driven 适配器 -->
        <subproject>facet-store-memory</subproject>
        <subproject>facet-fanout-structured</subproject>

        <!-- driving 适配器 -->
        <subproject>facet-pdp-http</subproject>

        <!-- 判定矩阵 golden file 的测试基建 -->
        <subproject>facet-testkit</subproject>
    </subprojects>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
