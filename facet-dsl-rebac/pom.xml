<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <!-- 4.1.0 model：parent 坐标按目录推断 -->
    <parent/>

    <artifactId>facet-dsl-rebac</artifactId>
    <name>Facet DSL :: ReBAC</name>
    <description>关系式 schema 前端。只做编译，不做判定。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-core</artifactId>
        </dependency>

        <!-- 断言 DSL 产出与 testkit 里手写的那份 IR 逐字段相同 -->
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- README 的五分钟示例是一个可执行的用例，它需要一个真实存储 -->
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-store-memory</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
